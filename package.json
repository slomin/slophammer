{
  "name": "slophammer",
  "version": "1.0.0",
  "description": "Chrome extension that scores text for AI-slop content.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "env -u NO_COLOR playwright test",
    "chrome": "bash scripts/launch-chrome.sh",
    "chrome:real": "bash scripts/launch-real-chrome.sh",
    "test-page": "node scripts/serve-test-page.mjs",
    "qa": "node scripts/qa-setup.mjs",
    "release": "node scripts/release.mjs",
    "store:assets": "node scripts/capture-store-assets.mjs",
    "reload": "node scripts/reload-extension.mjs",
    "setup:chrome": "node scripts/install-chrome-for-testing.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "debug": "node scripts/debug-extension.mjs",
    "qa:runtime": "node scripts/qa-runtime.mjs"
  },
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@puppeteer/browsers": "^2.13.0",
    "@types/chrome": "^0.1.40",
    "@types/node": "^25.6.0",
    "happy-dom": "^20.9.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4",
    "wxt": "^0.20.23"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^4.1.0",
    "fflate": "^0.8.2",
    "onnxruntime-web": "^1.24.3"
  }
}
